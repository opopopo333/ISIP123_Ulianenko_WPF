<Page x:Class="PR13.CheckoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR13"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CheckoutPage">

    <StackPanel Margin="10" VerticalAlignment="Top">
        <TextBlock Text="ФИО:" Margin="0,5,0,0"/>
        <TextBox x:Name="FullNameText" Margin="0,0,0,5"/>

        <TextBlock Text="Email:" Margin="0,5,0,0"/>
        <TextBox x:Name="EmailText" Margin="0,0,0,5"/>

        <TextBlock Text="Адрес доставки:" Margin="0,5,0,0"/>
        <TextBox x:Name="AddressText" Margin="0,0,0,5" Height="60" AcceptsReturn="True"/>

        <ListView x:Name="CartList" Height="200" Margin="0,10,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" DisplayMemberBinding="{Binding Product.Name}" Width="150"/>
                    <GridViewColumn Header="Количество" DisplayMemberBinding="{Binding Quantity}" Width="80"/>
                    <GridViewColumn Header="Сумма" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Product.Price, StringFormat=C}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="TotalText" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>
        <Button Content="Заказать" Width="150" Height="40" Click="PlaceOrder_Click"/>
    </StackPanel>
</Page>
