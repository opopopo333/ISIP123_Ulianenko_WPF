<Page x:Class="PR13.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR13"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage">
    <StackPanel Margin="10">
        <ListView x:Name="CartList" Height="200" Margin="0,10,0,0" ItemsSource="{Binding}">
            <ListView.View>
                <GridView>
                    <!-- Название товара -->
                    <GridViewColumn Header="Товар" DisplayMemberBinding="{Binding Product.Name}" Width="150"/>

                    <!-- Количество -->
                    <GridViewColumn Header="Количество" DisplayMemberBinding="{Binding Quantity}" Width="80"/>

                    <!-- Сумма за эту позицию -->
                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding Total}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="TotalText" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>
        <Button Content="Оформить заказ" Width="150" Height="40" Click="Checkout_Click"/>
    </StackPanel>
</Page>
